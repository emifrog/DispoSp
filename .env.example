# Optional: the demonstration works without a remote service.
# Use a dedicated development project, never an unrelated existing database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Set to "connected" to sign in against the Supabase project above.
# Anything else, or unset, keeps the local demonstration and needs no account.
NEXT_PUBLIC_DISPOSP_MODE=demo
